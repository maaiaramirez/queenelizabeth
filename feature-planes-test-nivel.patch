+   '["Acceso a niveles A1–B1","Biblioteca de audio RP","2 sesiones de tutoría/mes","Royal Badges básicos"]'::jsonb,
+   false, 1),
+  ('scholar', 'Scholar', 59,
+   '["Acceso completo A1–C2","Biblioteca BBC + Literatura","8 sesiones de tutoría/mes","Todos los Royal Badges","Reconocimiento de voz RP","Foro de comunidad"]'::jsonb,
+   true, 2),
+  ('royal', 'Royal', 99,
+   '["Todo lo de Scholar","Tutor dedicado personal","Sesiones ilimitadas 1-a-1","Certificado con sello real","Prioridad en grupos small"]'::jsonb,
+   false, 3)
+on conflict (slug) do nothing;
+
+-- 2) SALES: vincular venta <-> usuario, sin tocar lo que ya existe ----
+-- `plan_id` ya existe en sales como texto libre (dead code en sales.js,
+-- nunca se usó) -> lo reusamos como slug del plan, sin agregar columna.
+-- Solo sumamos student_user_id para poder resolver "¿este alumno logueado
+-- tiene una venta pendiente?" sin depender de matchear por email.
+alter table public.sales add column if not exists student_user_id uuid references auth.users(id) on delete set null;
+
+create index if not exists idx_sales_student_user_id on public.sales(student_user_id);
+create index if not exists idx_sales_status on public.sales(status);
+
+-- El alumno tiene que poder crear su propia venta pendiente al registrarse,
+-- y consultar el estado de la suya (antes solo el admin tenía acceso).
+drop policy if exists "sales_student_insert_own_pending" on public.sales;
+create policy "sales_student_insert_own_pending" on public.sales
+  for insert to authenticated
+  with check (student_user_id = auth.uid() and status = 'pendiente');
+
+drop policy if exists "sales_student_select_own" on public.sales;
+create policy "sales_student_select_own" on public.sales
+  for select to authenticated
+  using (student_user_id = auth.uid());
+
+-- 3) BANCO DE PREGUNTAS (Test de Nivel) -------------------------------
+-- OJO: correct_index NUNCA se lee desde el cliente (ni con RLS abierto).
+-- Solo lo toca el service role desde server.js (grading server-side).
+-- Por eso no hay policy de SELECT para authenticated acá: las preguntas
+-- se sirven vía /api/level-test/questions, que hace el strip del campo.
+create table if not exists public.level_test_questions (
+  id uuid primary key default gen_random_uuid(),
+  level text not null check (level in ('A1','A2','B1','B2','C1','C2')),
+  skill text not null default 'grammar' check (skill in ('grammar','vocabulary','reading','listening')),
+  question text not null,
+  options jsonb not null,          -- ["opción a","opción b","opción c","opción d"]
+  correct_index int not null check (correct_index between 0 and 3),
+  audio_url text,
+  is_active boolean not null default true,
+  created_at timestamptz not null default now()
+);
+
+alter table public.level_test_questions enable row level security;
+
+-- Sin policy de select para authenticated a propósito (ver nota arriba).
+drop policy if exists "level_test_questions_admin_all" on public.level_test_questions;
